# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do front-end (Vite) — autenticação Microsoft Entra ID
#
# Apenas VALORES PÚBLICOS. SPAs são "public clients": NÃO há client secret.
# NÃO coloque segredos, chaves ou connection strings aqui (ver R9: Key Vault).
# Copie este arquivo para `.env.local` e preencha com os valores do app
# registrado no Entra ID. O prefixo VITE_ é obrigatório para o Vite expor a
# variável ao bundle do navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ID (Application/Client ID) do app registrado no Entra ID — PÚBLICO.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant do Entra ID (GUID ou domínio). Usado para montar a authority quando
# VITE_ENTRA_AUTHORITY não é informada.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# (Opcional) Authority completa; tem prioridade sobre o tenant acima.
# VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant>

# (Opcional) URI de redirecionamento registrado. Se ausente, usa a origem atual.
# VITE_ENTRA_REDIRECT_URI=https://orcamento-mt.interno.cemig/

# (Opcional) URI de redirecionamento pós-logout. Se ausente, usa o redirectUri.
# VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=https://orcamento-mt.interno.cemig/

# (Opcional) Escopos de acesso à API, separados por espaço ou vírgula.
# Ex.: api://orcamento-mt/access
# VITE_ENTRA_API_SCOPES=api://orcamento-mt/access
